# .dockerignore for the commit-image build. Bake in the FULL repo (incl. .git — the
# grader uses it), dropping only local build artifacts and editor/OS cruft.

# ── Build outputs / local cruft ──────────────────────────────────────────────
target/
mayhem/fuzz/target/
mayhem/test-target/
build/
out/
*.o
*.a
*.so
*.dylib
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
